<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0</TargetFrameworks>
    <RootNamespace>Confluent.Kafka</RootNamespace>
    <AssemblyName>Confluent.Kafka.Abstractions</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>..\Confluent.Kafka\Confluent.Kafka.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Key= causes the SDK to auto-extract the public key from the .snk so the
         strong-named Confluent.Kafka assembly is accepted as a trusted friend. -->
    <InternalsVisibleTo Include="Confluent.Kafka"
                        Key="" />
  </ItemGroup>

</Project>
